# Copy to .env and fill locally. Never commit real values.
# Team: share secrets in chat / 1Password — not in git.

# OpenAI (agents + embeddings)
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Optional alternate provider (unused if OpenAI is set)
ANTHROPIC_API_KEY=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=stock_simulation
