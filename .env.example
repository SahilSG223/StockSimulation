# Copy to .env and fill locally. Never commit real values.

# OpenAI key for agent decisions and experience embeddings
OPENAI_API_KEY=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=stock_simulation

# Required: OpenAI embedding model for experience narratives and retrieval queries
# AGENT_MODEL makes decisions; EMBEDDING_MODEL produces vectors, not vice versa.
EMBEDDING_MODEL=

# Required for LLM agents: OpenAI model id supporting structured outputs
AGENT_MODEL=
