# Copy to .env and fill locally. Never commit real values.

# OpenAI key for agent decisions and experience embeddings
OPENAI_API_KEY=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=stock_simulation

# Required: OpenAI embedding model for experience narratives and retrieval queries
# AGENT_MODEL makes decisions; EMBEDDING_MODEL produces vectors, not vice versa.
EMBEDDING_MODEL=

# Required for LLM agents: OpenAI model id supporting structured outputs
AGENT_MODEL=

# Optional live-run controls (defaults: 27 total ticks; longer scenarios extend automatically, all agents, shock_mid, seed 42)
# First 20 ticks warm the public feed without decision calls.
# AGENT_TICKS=
# AGENTS=
# AGENT_SCENARIO=
# AGENT_SEED=
# Set a label deliberately to reuse the same agents' private memories across runs.
# AGENT_RUN_LABEL=
