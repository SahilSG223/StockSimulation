# Copy to .env and fill locally. Never commit real values.
# Team: share how to obtain keys in chat / 1Password — not in git.

# LLM provider (pick one; leave others unset)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MongoDB Atlas connection string (shared hackathon cluster preferred)
MONGODB_URI=
MONGODB_DB_NAME=stock_simulation

# Embedding model id used for semantic memory (document which one in PRs)
EMBEDDING_MODEL=

# Optional: override default LLM model for agent decisions
AGENT_MODEL=
