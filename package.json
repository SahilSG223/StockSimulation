{
  "name": "stock-simulation",
  "version": "0.1.0",
  "private": true,
  "description": "Governed memory stress-testing for autonomous AI agents in a simulated market",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "memory:prepare": "tsx src/memory/prepare.ts",
    "memory:check": "tsx src/memory/check.ts",
    "agents": "tsx src/agents/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts experiments",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\" \"*.config.js\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\" \"*.config.js\" \"package.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "precommit": "pnpm typecheck && pnpm test",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "experiments": "vitest run tests/experiments/suite.integration.test.ts",
    "ensure-indexes": "tsx scripts/ensure-indexes.ts",
    "eval": "tsx src/evaluation/suite.ts",
    "demo:json": "tsx scripts/demo-json.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "mongodb": "^7.9.0",
    "openai": "4.77.0",
    "zod": "^3.24.1"
  }
}
